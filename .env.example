# ARQUIVO DE EXEMPLO — NÃO COLE A CHAVE REAL AQUI
# Na hospedagem, crie a variável abaixo e cole a chave no VALOR.

GEMINI_API_KEY=COLE_NO_PAINEL_SECRETO_DA_HOSPEDAGEM
#              ↑
#              └── sua chave real vai no painel da hospedagem, NÃO neste arquivo

GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGIN=https://maxoutlier7-jpg.github.io
